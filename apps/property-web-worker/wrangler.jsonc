{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ancu-property-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ancu-property-db",
      // CI/scripts/cf-deploy.sh replaces with real database_id
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ancu-property-assets"
    }
  ],
  "env": {
    "preview": {
      "name": "ancu-property-web-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ancu-property-db",
          // CI replaces preview database_id
          "database_id": "00000000-0000-0000-0000-000000000002"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "ancu-property-assets"
        }
      ]
    },
    "production": {
      "name": "ancu-property-web",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ancu-property-db",
          // CI replaces production database_id
          "database_id": "00000000-0000-0000-0000-000000000003"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "ancu-property-assets"
        }
      ]
    }
  }
}
