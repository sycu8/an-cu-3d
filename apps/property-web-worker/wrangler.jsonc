{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ancu-property-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // Config is the source of truth. keep_vars true would preserve a dashboard
  // copy that omitted ENGINE_BASE_URL and the build would keep skipping the engine.
  "keep_vars": false,
  "vars": {
    "ENGINE_BASE_URL": "https://ancu-floorplan-engine.sycu-lee.workers.dev"
  },
  "triggers": {
    // Weekly Monday 01:00 UTC — draft blog suggestion only (no auto-publish)
    "crons": ["0 1 * * 1"]
  },
  "assets": {
    "directory": "./dist",
    // R2 already binds as ASSETS. This name is the static-asset Fetcher.
    "binding": "STATIC_ASSETS",
    "not_found_handling": "single-page-application",
    // API and hashed chunks hit the Worker. Other routes stay on the asset platform,
    // which still returns index.html for SPA navigations.
    // Unknown /assets/* must 404: the platform would otherwise serve index.html.
    "run_worker_first": ["/api/*", "/assets/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ancu-property-db",
      // CI/scripts/cf-deploy.sh replaces with real database_id
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ancu-property-assets"
    }
  ],
  "env": {
    "preview": {
      "name": "ancu-property-web-preview",
      "vars": {
        "ENGINE_BASE_URL": "https://ancu-floorplan-engine.sycu-lee.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ancu-property-db",
          // CI replaces preview database_id
          "database_id": "00000000-0000-0000-0000-000000000002"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "ancu-property-assets"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "ancu-property-web",
      "vars": {
        "ENGINE_BASE_URL": "https://ancu-floorplan-engine.sycu-lee.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ancu-property-db",
          // CI replaces production database_id
          "database_id": "00000000-0000-0000-0000-000000000003"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "ancu-property-assets"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "ai": {
        "binding": "AI"
      }
    }
  }
}
